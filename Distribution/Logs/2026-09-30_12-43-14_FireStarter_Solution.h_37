#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    n *= -0.04575312f;
    r1 = n *= -0.48964468f;
    r2 = n *= 2.35565352f;
    n *= -0.00054460f;
    n *= -5.23504543f;
    n += r2;
    r2 = n *= -1.11101627f;
    n *= 0.93268597f;
    n *= r0;
    r0 = n += -0.45261547f;
    r3 = n += 2.30276489f;
    r4 = n *= -1.71039057f;
    n += -1.72304487f;
    n += -0.90339839f;
    r5 = n *= 1.00914466f;
    n += r0;
    n += 0.91627628f;
    n += -1.75772512f;
    n *= 1.16119099f;
    n *= r4;
    n = r2 *= n;
    n *= -0.49473727f;
    n *= r1;
    n *= -0.23374185f;
    n *= r5;
    n *= -2.57223010f;
    n += -0.97598195f;
    n += r3;
    n *= r2;
    n *= -2.83552623f;
    n *= -0.26159012f;
    return n;
} // Solution
