#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    r0 = n += -3.14159274f;
    r1 = n *= -0.21254458f;
    n *= 0.79864252f;
    r2 = n *= -2.17310309f;
    r3 = n *= -0.15585394f;
    r4 = n *= -0.91573393f;
    n *= r3;
    n *= -55.67145538f;
    n *= -3.05855823f;
    n *= -0.04077810f;
    r3 = n += -1.73619342f;
    r5 = n *= -1.09333742f;
    r6 = n += -0.34387952f;
    n = r3 *= n;
    n *= -0.63824528f;
    n *= -0.89226526f;
    n *= r3;
    n *= 1.33152676f;
    n *= -1.49360847f;
    n += -0.69597381f;
    n *= -0.79134923f;
    n += r5;
    n *= -0.12891090f;
    n *= r0;
    n += r1;
    n *= r4;
    n = r6 *= n;
    n *= -5.03093338f;
    n += -1.52930248f;
    n += r6;
    n += -1.18161654f;
    n *= r2;
    return n;
} // Solution
