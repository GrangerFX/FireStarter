#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    r1 = n *= -0.16709863f;
    n = r1 *= n;
    n += r1;
    n *= -2.91832447f;
    r1 = n *= 0.33643037f;
    n += -0.38079143f;
    r2 = n += -0.21450038f;
    r3 = n += 1.07240772f;
    n *= -0.90637279f;
    n += 2.69031739f;
    r4 = n *= 0.79750276f;
    n = r2 += n;
    n += 1.68830132f;
    r5 = n += -0.93576884f;
    n *= r2;
    n = r3 *= n;
    n *= 0.27816781f;
    r2 = n += -0.04864422f;
    n = r1 += n;
    n *= -0.09250152f;
    n *= -11.10861588f;
    n += r4;
    n *= r3;
    n *= r5;
    n *= -2.06252289f;
    n += r1;
    n += r2;
    n *= 0.68122524f;
    n *= r0;
    n *= -0.92355520f;
    n *= -0.17869830f;
    return n;
} // Solution
