#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    r1 = n *= 0.21735476f;
    n *= r0;
    n += 0.99700087f;
    r0 = n *= -0.04558817f;
    r2 = n += 0.13337000f;
    r3 = n *= -0.19749078f;
    n += 0.08159189f;
    n *= 1.96372354f;
    r4 = n *= 2.18125939f;
    n *= 0.05218184f;
    n += r4;
    n += r2;
    n *= 2.27201867f;
    r2 = n *= 1.91298819f;
    n = r0 += n;
    r4 = n *= -0.31651467f;
    n = r4 *= n;
    n = r2 *= n;
    r5 = n *= 3.67777729f;
    n += r4;
    n += r2;
    n *= r0;
    n *= 0.67334062f;
    r0 = n *= -4.56093931f;
