#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    n *= 2.50662422f;
    n *= -1.31263995f;
    r1 = n *= -1.46131563f;
    n *= 0.00368589f;
    n *= -1.30801642f;
    r2 = n *= -360.32781982f;
    n *= -0.11334775f;
    n += r0;
    r0 = n *= 0.80289549f;
    n *= r2;
    n += -0.81730348f;
    n *= 0.08186403f;
    r2 = n += -2.28900933f;
    n += 0.82847446f;
    r3 = n *= 0.09085815f;
    r4 = n *= -2.30240035f;
    r5 = n *= 1.43457472f;
    n = r4 *= n;
    n = r3 *= n;
    n *= 1.55329561f;
    n *= r4;
    n *= -2.09976554f;
    n += r5;
    n *= r2;
    n = r0 *= n;
    n *= r0;
    n += r3;
    n *= 4.63310909f;
    n *= r1;
    n *= -1.63900566f;
    n *= -1.34740388f;
    return n;
} // Solution
