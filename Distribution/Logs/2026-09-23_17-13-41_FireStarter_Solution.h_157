    r0 = n *= 1.57282877f;
    r2 = n *= 1.37774920f;
    n *= -2.03763199f;
    r3 = n *= 0.02045530f;
    n *= -2.21120977f;
    n = r0 *= n;
    n *= -1.49337614f;
    n += r2;
    r2 = n += -1.69043791f;
    n *= 2.45810509f;
    n += r0;
    n += 0.62337250f;
    n += 2.38328910f;
    n *= -0.03615865f;
