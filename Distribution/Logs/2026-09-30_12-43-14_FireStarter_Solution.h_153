#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    n += -3.14159250f;
    r0 = n *= 0.15551350f;
    r1 = n *= 2.62146401f;
    n = r0 *= n;
    n += -2.06237626f;
    r2 = n *= 0.11905597f;
    n += -3.56045365f;
    r3 = n += 1.84973478f;
    n *= r2;
    n += -0.38806885f;
    r2 = n *= 1.03207755f;
    n = r3 *= n;
    n = r2 += n;
    n += 0.19290149f;
    n *= 0.01913307f;
    n += r3;
    n *= -0.01392716f;
    n *= 0.05354739f;
    n *= 4.28145409f;
    r3 = n += 1.84954405f;
    n *= -1.08614635f;
    n *= r2;
    r2 = n += 0.61870188f;
    r4 = n *= 3.07299137f;
    n += r3;
    n += 1.07721031f;
    n *= r0;
    n += r2;
    n += -3.28572869f;
    n *= r4;
    n *= 0.40083081f;
    n *= r1;
    return n;
} // Solution
