#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    r1 = n *= 0.28585219f;
    r2 = n *= -0.58403069f;
    n = r2 += n;
    r3 = n += -0.00000001f;
    n = r1 += n;
    n = r3 *= n;
    n += -0.60369849f;
    n *= -0.29014626f;
    r4 = n *= -4.02656984f;
    n += -0.15243347f;
    r5 = n *= 0.34860468f;
    n *= r0;
    n *= -0.91761696f;
    n = r5 *= n;
    n = r2 += n;
    r0 = n *= -0.97370088f;
    n *= -2.79093623f;
    n *= r5;
    n = r4 += n;
    n *= r3;
    n *= 0.00194085f;
    n = r0 *= n;
    n *= r1;
    n *= r0;
    n *= 5.68771553f;
    r0 = n *= 3.47261262f;
    n += r4;
    n *= r2;
    n *= -3.00248575f;
    n += r0;
    n *= 1.13533199f;
    return n;
} // Solution
