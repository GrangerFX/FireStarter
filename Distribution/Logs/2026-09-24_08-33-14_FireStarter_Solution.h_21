#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3;

    r0 = n += -3.14159274f;
    n *= -1.04351985f;
    n += r0;
    r0 = n *= 2.32986379f;
    r1 = n *= -1.27357638f;
    n = r0 *= n;
    n *= -0.18632957f;
    n = r0 += n;
    n += 2.52159786f;
    n *= 1.28863108f;
    r2 = n *= -1.32644892f;
    n = r0 *= n;
    n += r2;
    n += -3.29916334f;
    r2 = n *= 0.94942778f;
    n *= 0.36629623f;
    n *= -2.24158740f;
    n = r0 *= n;
    n *= -2.09119821f;
    n += 1.87939644f;
    n *= 0.01641373f;
    n *= -2.05032372f;
    r3 = n += -0.38022846f;
    n += 1.09746635f;
    n *= -0.53687114f;
    n += -1.15351272f;
    n *= 1.48574424f;
    n += r0;
    n *= 1.08120036f;
    n *= r3;
    n *= r2;
    n *= r1;
    return n;
} // Solution
