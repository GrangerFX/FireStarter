#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    r1 = n *= -0.21024524f;
    n *= r1;
    n *= 0.03168439f;
    r1 = n *= -6.22923565f;
    r2 = n += 1.39397204f;
    r3 = n *= -0.92745805f;
    n *= 3.29015255f;
    r4 = n *= 0.48881951f;
    r5 = n *= 0.61610425f;
    n = r1 *= n;
    n *= r2;
    n *= 1.09105444f;
    r2 = n *= 0.78888190f;
    n *= 10.59704781f;
    n += r3;
    n *= -1.58528948f;
    n += 0.18657041f;
    n += 0.50578290f;
    n += -1.13994944f;
    r3 = n *= 0.50808209f;
    n = r2 += n;
    n = r1 += n;
    n += -0.50127888f;
    n *= r1;
    n *= 26.56336021f;
    n *= -0.00675105f;
    n *= r5;
    n += r2;
    n *= r4;
    n += r3;
    n *= r0;
    return n;
} // Solution
