#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    n += -3.14159274f;
    r0 = n *= -0.16409644f;
    n *= -1.68356025f;
    r1 = n *= 0.13409889f;
    r2 = n *= -6.04386091f;
    n = r1 *= n;
    n *= 0.05916955f;
    n *= -4.24388075f;
    r3 = n += -1.51176167f;
    n *= 0.21148480f;
    n = r1 *= n;
    n += -0.35730991f;
    n *= -2.49380207f;
    n *= -4.33253193f;
    r4 = n *= -0.31275117f;
    n *= 1.33502626f;
    n *= 0.56782007f;
    n *= -2.31620288f;
    n = r1 += n;
    n += 0.45045334f;
    n *= r2;
    r2 = n *= -3.42487288f;
    n *= r1;
    n = r4 *= n;
    n *= -0.04105066f;
    n *= 1.16393256f;
    n *= 1.87979758f;
    n *= r4;
    n += r3;
    n *= r0;
    n += r2;
    n *= 0.96882015f;
    return n;
} // Solution
