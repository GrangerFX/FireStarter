#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    r0 = n += -3.14159250f;
    n *= 1.53721750f;
    r1 = n *= 0.01580137f;
    n = r0 *= n;
    r2 = n += -1.74772894f;
    n += r0;
    r0 = n *= 1.79351282f;
    n *= 0.63907254f;
    n *= 1.87079406f;
    n *= 0.92190927f;
    n *= 0.07055312f;
    r3 = n += 0.17688605f;
    n *= -3.98183084f;
    n *= -0.31022355f;
    r4 = n += 2.16261125f;
    r5 = n += -2.29603672f;
    r6 = n += 0.82160628f;
    n *= -2.31530738f;
    n += r4;
    n *= -0.89773989f;
    n *= r2;
    n += r5;
    r5 = n *= 2.26437688f;
    n += r6;
    n *= 1.36894166f;
    n += 2.99687624f;
    n *= 5.41462421f;
    n *= r0;
    n *= r3;
    n *= -2.92850399f;
    n *= r5;
    n *= r1;
    return n;
} // Solution
