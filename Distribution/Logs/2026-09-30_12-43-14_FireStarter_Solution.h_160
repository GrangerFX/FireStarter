#ifndef __CUDACC__
#include <cmath>
#endif

#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    r0 = n += -3.14159274f;
    n *= -0.37058824f;
    r1 = n *= 0.16888462f;
    n *= -8.53081989f;
    n *= r0;
    n *= -2.49656510f;
    r0 = n *= -0.37557209f;
    n += -3.96602798f;
    r2 = n *= 4.34728050f;
    n *= -0.97074723f;
    n += 11.18689251f;
    r3 = n += 2.88151026f;
    n = r2 += n;
    n += -1.82553351f;
    r4 = n *= 0.78438354f;
    n *= -1.32353926f;
    n += r2;
    r2 = n += -1.30301261f;
    n *= -3.07781577f;
    r5 = n *= -3.65969586f;
    r6 = n += 0.81184971f;
    n *= r4;
    n *= -2.73611617f;
    n *= r6;
    n *= r2;
    n *= r0;
    n *= 0.78642017f;
    n += r3;
    n *= r1;
    n *= -0.55768281f;
    n *= -1.10752952f;
    n *= r5;
    return n;
} // Solution
