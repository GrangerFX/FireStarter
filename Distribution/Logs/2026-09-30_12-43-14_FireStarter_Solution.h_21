#ifndef __CUDACC__
#include <cmath>
#endif

#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    r0 = n += -3.14159274f;
    r1 = n *= -0.84906226f;
    n *= r1;
    r1 = n += -2.11141372f;
    n += -2.70890903f;
    n *= 0.02220698f;
    n *= -4.21187258f;
    r2 = n *= 0.01688986f;
    n += 1.96507478f;
    r3 = n += -0.06401033f;
    n = r2 += n;
    n *= -0.06039477f;
    n *= 3.47140598f;
    r4 = n *= -1.76093996f;
    n *= 2.12537289f;
    n *= r2;
    r2 = n += -1.20400226f;
    n *= r3;
    r3 = n *= 0.14278504f;
    n *= 2.30686784f;
    n = r4 *= n;
    n *= r1;
    n += r2;
    n += 0.93480045f;
    n *= r3;
    n *= -0.68947542f;
    n += 1.82448804f;
    n = r4 *= n;
    n += 1.63573980f;
    n *= r0;
    n *= -0.32506061f;
    n *= r4;
    return n;
} // Solution
