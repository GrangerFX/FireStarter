#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    n += -3.14159274f;
    r0 = n *= -0.17132476f;
    r1 = n *= -0.74242181f;
    n *= -2.07144165f;
    n *= -6.01474142f;
    n *= -1.44364381f;
    n *= r0;
    n *= 0.46654981f;
    r0 = n *= 0.88254893f;
    n += -1.35046530f;
    r2 = n += -0.95600456f;
    r3 = n += 0.86412907f;
    n *= -0.09806868f;
    r4 = n += 1.44167519f;
    n *= 0.18386725f;
    n = r2 *= n;
    n += -3.61459303f;
    n *= r0;
    n *= 0.95015997f;
    r0 = n *= 1.95765579f;
    n += r4;
    n *= -3.99649525f;
    n *= -1.04418254f;
    n *= -0.24722269f;
    n = r0 += n;
    n *= r0;
    n *= r3;
    n += r2;
    n *= 1.26571238f;
    n = r1 *= n;
    n *= 0.37454265f;
    n += r1;
    return n;
} // Solution
