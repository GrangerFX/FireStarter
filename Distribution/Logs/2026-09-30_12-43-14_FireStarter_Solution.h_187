#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    n *= 1.65005589f;
    r1 = n *= 1.33061051f;
    n *= 0.39300701f;
    n *= r1;
    r1 = n += -7.25343990f;
    n += r1;
    n *= 0.24585100f;
    n *= 0.03748992f;
    r1 = n *= 1.68286872f;
    r2 = n *= -0.96572226f;
    r3 = n += 1.19578815f;
    n += -1.44934881f;
    n = r1 += n;
    r4 = n *= -2.27556682f;
    n *= -0.41902211f;
    r5 = n *= 2.99350286f;
    n *= -0.18979092f;
    n *= r5;
    r5 = n *= 2.18240404f;
    n *= r4;
    r4 = n *= -9.44445515f;
    n += r3;
    r3 = n += 1.67820072f;
    n *= r2;
    n *= r3;
    n *= r1;
    n *= 0.18839003f;
    n = r5 += n;
    n *= r4;
    n += r5;
    n *= r0;
    return n;
} // Solution
