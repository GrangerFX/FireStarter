    n = r4 *= n;
    n *= 0.29020360f;
    r5 = n += 1.18420279f;
    n += -0.46540976f;
    n = r4 *= n;
    r6 = n += -2.01192427f;
    n *= -0.25037488f;
    n = r1 *= n;
    n = r5 *= n;
    n *= 0.07381961f;
    n *= r0;
    n *= r1;
