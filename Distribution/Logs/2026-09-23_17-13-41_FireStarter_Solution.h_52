#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    n *= 0.06052611f;
    r1 = n *= -4.57168055f;
    n *= r1;
    n *= 0.87692249f;
    n += 1.62460005f;
    r1 = n += -2.13900971f;
    r2 = n *= -0.96398884f;
    n += r1;
    n *= 7.84314585f;
    r1 = n += -1.68444037f;
    r3 = n *= -0.33284566f;
    r4 = n *= -1.83029819f;
    n += 0.41355819f;
    n *= 1.37790394f;
    n *= -0.31014475f;
    n = r4 += n;
    n = r1 *= n;
    n *= 0.38048455f;
    n *= -0.56284201f;
    n = r1 *= n;
    r5 = n *= -1.64061570f;
    n *= 0.29069695f;
    n += 3.56365728f;
    n *= r4;
    n *= -2.20038891f;
    n *= r1;
    n *= r2;
    n += r5;
    n += -0.81765819f;
    n *= r0;
    n *= r3;
    return n;
} // Solution
