#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    r0 = n += -3.14159274f;
    r1 = n *= -0.07769410f;
    r2 = n *= 1.37319136f;
    n += r1;
    r1 = n *= 0.05323508f;
    n *= r0;
    r0 = n += 1.53865314f;
    n += -1.08232558f;
    n *= 2.26515174f;
    r3 = n += 2.50743675f;
    r4 = n += -0.85850996f;
    n *= -0.90664059f;
    r5 = n += -0.33914196f;
    n += -0.08652630f;
    n = r2 *= n;
    r6 = n *= 0.30606475f;
    n *= 0.71644944f;
    n *= r2;
    r2 = n += 0.16999662f;
    n *= -3.39525628f;
    n *= 0.11967930f;
    n += r4;
    n *= -0.75282449f;
    n = r0 += n;
    n += r2;
    n *= r6;
    n *= r3;
    n *= r0;
    n *= -3.00288558f;
    n += r1;
    n *= r5;
    n *= -3.00773120f;
    return n;
} // Solution
