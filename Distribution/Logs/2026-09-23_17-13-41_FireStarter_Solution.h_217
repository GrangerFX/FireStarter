#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    r0 = n += -3.14159250f;
    r1 = n *= 0.77654111f;
    n *= r1;
    n *= 1.09281993f;
    n *= -0.19630937f;
    r1 = n += 1.00424695f;
    n *= 0.93266183f;
    n *= -0.08452928f;
    r2 = n += 0.00925557f;
    r3 = n *= -5.64624071f;
    r4 = n *= -2.78678823f;
    n *= 0.01901498f;
    n *= 1.42672479f;
    n *= -3.26466441f;
    n *= -0.44059545f;
    n *= r4;
    n *= 2.99465847f;
    n = r1 += n;
    r4 = n *= 0.64133888f;
    n *= -2.61688924f;
    n += r3;
    n += 1.59979951f;
    n *= r2;
    n += r4;
    r4 = n += 0.10075857f;
    r2 = n *= -1.62645149f;
    n += r4;
    n *= 0.28277841f;
    n *= r1;
    n += r2;
    n *= 0.65818012f;
    n *= r0;
    return n;
} // Solution
