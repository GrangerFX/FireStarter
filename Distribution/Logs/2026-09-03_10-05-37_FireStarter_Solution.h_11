#define SOLUTION_VARIATIONS 1
#define SOLUTION_VARIATION 0

#ifndef __CUDACC__
#include <cmath>
#endif

#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    r0 = n += -3.14159274f;
    n *= 1.97791851f;
    r1 = n *= -2.14661837f;
    n *= -0.00702664f;
    n *= 0.59359217f;
    n = r1 *= n;
    n += 6.17617130f;
    r2 = n *= 0.02640079f;
    n += r1;
    n *= -0.78195399f;
    n *= -3.74382830f;
    r1 = n += 1.18716252f;
    n += -0.94411045f;
    n *= -2.39700723f;
    n *= 0.03052639f;
    r3 = n += -2.18682480f;
    n *= -0.42338526f;
    r4 = n += -0.62534320f;
    n *= r1;
    n = r2 += n;
    n *= r4;
    n *= -0.52873003f;
    n += r3;
    n *= -8.60680962f;
    n += -12.32326126f;
    n += -1.20437372f;
    n *= 0.71983457f;
    n *= -0.08990279f;
    n *= -6.17567968f;
    n *= -0.52713859f;
    n *= r0;
    n *= r2;
    return n;
} // Solution
