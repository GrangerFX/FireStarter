#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3;

    n += -3.14159274f;
    r0 = n *= 0.71288526f;
    n *= -0.03883997f;
    r1 = n *= 2.43108582f;
    n *= r1;
    n *= 1.09337306f;
    n *= 0.74577361f;
    n *= -1.92161083f;
    r1 = n += 1.34538102f;
    n = r1 *= n;
    n *= 2.49494267f;
    r2 = n *= 0.69796920f;
    n += 1.58086860f;
    n += -1.01618969f;
    n += -0.07101793f;
    r3 = n *= -0.15658538f;
    n *= r2;
    n += 1.56361163f;
    n *= r3;
    n *= -0.96770495f;
    r3 = n *= -0.31618190f;
    n += r3;
    n *= 6.90997744f;
    r3 = n += 1.11492312f;
    r2 = n *= 4.79531860f;
    n *= r3;
    n *= -1.48817885f;
    n += r1;
    n += r2;
    n *= 0.32596901f;
    n *= r0;
    n *= 0.41571835f;
    return n;
} // Solution
