#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    n += -3.14159250f;
    r0 = n *= 0.12223823f;
    r1 = n *= -1.90759301f;
    r2 = n *= 1.98488665f;
    r3 = n *= 0.41801256f;
    n = r1 += n;
    n *= -0.00000035f;
    n *= -5.37150955f;
    n *= 1.56557167f;
    n *= -2.28001761f;
    n += 0.69943780f;
    n *= -2.16496158f;
    n += 1.38054621f;
    n = r3 += n;
    n += 0.26741931f;
    n = r3 *= n;
    n += -1.83366323f;
    n = r1 *= n;
    r4 = n *= 2.76140881f;
    n *= r0;
    n += -1.84102154f;
    n *= 1.23733521f;
    r0 = n += -0.23801143f;
    n *= 0.52563035f;
    n += r3;
    n *= r2;
    n *= 0.89112771f;
    n *= r4;
    n *= 0.03193441f;
    n += r0;
    n *= r1;
    n *= 0.50313622f;
    return n;
} // Solution
