#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    r1 = n *= 2.98911667f;
    n *= r1;
    n *= 0.01355951f;
    r1 = n *= -0.13248135f;
    r2 = n += 2.37129402f;
    r3 = n *= -0.81090134f;
    n *= -1.27859259f;
    r4 = n *= -0.64870679f;
    r5 = n *= -1.15025556f;
    n = r1 *= n;
    n *= r2;
    n *= 2.94267678f;
    r2 = n *= 0.05624090f;
    n *= 24.15352249f;
    n += r3;
    n *= -1.95492947f;
    n += -3.82853007f;
    n += -8.19596481f;
    n += 2.81306529f;
    r3 = n *= -0.27963772f;
    n = r2 += n;
    n = r1 += n;
    n += -0.99307650f;
    n *= r1;
    n *= -2.06806374f;
    n *= -0.01895569f;
    n *= r5;
    n += r2;
    n *= r4;
    n += r3;
    n *= r0;
    return n;
} // Solution
