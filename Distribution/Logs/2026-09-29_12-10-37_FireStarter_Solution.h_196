#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= 0.03489510f;
    r0 = n *= -2.81783724f;
    r1 = n *= 2.66344500f;
    n *= 0.17687222f;
    r2 = n *= 2.03133059f;
    n *= -2.30184698f;
    n *= r1;
    n *= 0.76266235f;
    r1 = n *= 1.08030570f;
    r3 = n *= -1.31768394f;
    n += -0.20779750f;
    n *= -0.46887055f;
    r4 = n += 2.83769608f;
    r5 = n += 0.74568778f;
    r6 = n *= 1.88584805f;
    n *= r3;
    n += -1.11775541f;
    n += -0.18115978f;
    n *= -0.01953346f;
    n *= 3.65572000f;
    n *= 2.28401375f;
    n = r5 += n;
    n = r5 *= n;
    n *= 0.05370811f;
    n += r6;
    n *= r1;
    n += r4;
    n *= r5;
    n *= r0;
    n *= 0.20714852f;
    n += r2;
    return n;
} // Solution
