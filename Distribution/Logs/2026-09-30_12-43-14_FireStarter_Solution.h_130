#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    r1 = n *= -0.16111268f;
    n *= r0;
    r0 = n *= -0.07863463f;
    r2 = n += -0.49860963f;
    r3 = n *= -1.16841161f;
    n += 2.20561886f;
    n = r2 *= n;
    r4 = n *= -0.93615669f;
    n += 0.00753568f;
    n *= r3;
    n *= -3.14776874f;
    n *= -0.04286278f;
    r3 = n *= 2.03455901f;
    n *= 3.90758228f;
    n *= 0.98585498f;
    n *= 0.41858774f;
    r5 = n *= 0.01776411f;
    n *= -1.98134816f;
    n += r4;
    n *= r0;
    n += 0.15212889f;
    n *= r5;
    n = r2 += n;
    r5 = n += -1.46609056f;
    n = r2 *= n;
    n += r5;
    n *= 1.64976466f;
    n *= 0.82435924f;
    n *= r2;
    n += r3;
    n *= r1;
    return n;
} // Solution
