#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    r1 = n *= -0.10977177f;
    n *= r1;
    n += -1.49314332f;
    r1 = n *= -0.04385405f;
    r2 = n *= 0.58890551f;
    r3 = n *= -2.57360578f;
    n *= r3;
    r3 = n *= 1.41299617f;
    n += 2.32912159f;
    r4 = n *= 1.84560001f;
    n = r3 += n;
    r5 = n *= 2.16820812f;
    n += -2.13120675f;
    n *= 0.03887980f;
    n = r5 *= n;
    n = r3 *= n;
    n *= r3;
    n *= r1;
    n += -0.93748343f;
    n *= r0;
    n = r2 *= n;
    n *= -0.19995140f;
    n *= r4;
    n *= r5;
    r5 = n *= 0.87207568f;
    n *= r5;
    n += -1.88646710f;
    n *= -1.26758015f;
    n += 0.70616311f;
    n *= r2;
    n *= -1.07534087f;
    return n;
} // Solution
