#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14132595f;
    r1 = n *= -0.36045128f;
    r2 = n *= 0.76683837f;
    n = r2 *= n;
    r3 = n += -1.06697011f;
    r4 = n *= -2.02528214f;
    r5 = n *= 1.04343748f;
    n += r5;
    n += r3;
    r3 = n *= -0.89522475f;
    n += -2.18232179f;
    r5 = n *= 0.09167863f;
    n *= 2.23962116f;
    n += r4;
    n *= -1.56967342f;
    n = r5 *= n;
    n *= r1;
    r1 = n *= 0.65177107f;
    n *= r3;
    n += r0;
    n += 2.37932444f;
    n = r2 *= n;
    n *= 1.16015840f;
    n *= r2;
    n *= -1.87276959f;
    n *= -0.02865013f;
    n *= -1.03383064f;
    r2 = n *= -0.12704006f;
    n *= r2;
    n += 4.37727594f;
    n += r5;
    n *= r1;
    return n;
} // Solution
