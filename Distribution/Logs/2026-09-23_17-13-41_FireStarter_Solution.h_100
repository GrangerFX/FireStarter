#define SOLUTION_VARIATIONS 1
#define SOLUTION_VARIATION 0

#ifndef __CUDACC__
#include <cmath>
#endif

#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    r0 = n += -1.57079625f;
    n = r0 *= n;
    n *= -0.86463761f;
    n = r0 += n;
    r1 = n *= -0.78110319f;
    n += 1.74271667f;
    r2 = n *= 1.23741996f;
    r3 = n *= 0.88079596f;
    r4 = n *= -0.79932618f;
    n *= 0.15993814f;
    n = r0 += n;
    n += r1;
    r1 = n *= 1.71874416f;
    r5 = n *= 1.56452250f;
    n = r2 += n;
    n = r2 *= n;
    r6 = n *= 0.55666912f;
    n *= -0.56828076f;
    n += 0.30523536f;
    n = r2 += n;
    n *= r2;
    n = r1 *= n;
    n *= r3;
    n *= r4;
    n += r5;
    n *= -0.00350581f;
    n += -2.57737398f;
    n += r1;
    n *= r0;
    n *= r6;
    n += 0.51246667f;
    n *= 0.57453936f;
    return n;
} // Solution
