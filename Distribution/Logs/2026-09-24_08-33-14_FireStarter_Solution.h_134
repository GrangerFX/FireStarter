#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6, r7;

    r0 = n += -3.14159274f;
    n *= 1.42182982f;
    r1 = n *= -0.01858922f;
    n *= r0;
    n *= 1.26985824f;
    n += 2.97884583f;
    r0 = n *= -2.20562339f;
    r2 = n *= -0.60226953f;
    r3 = n += -3.54451752f;
    n *= 1.95188355f;
    n += 1.00214756f;
    n += -1.65170240f;
    r4 = n *= -0.80379468f;
    r5 = n *= 0.89981335f;
    n += -1.12938952f;
    n = r3 += n;
    r6 = n *= -1.30264962f;
    n *= -2.03805566f;
    r7 = n *= -0.48567113f;
    n *= r2;
    n += r4;
    n *= -5.29125929f;
    n += r7;
    n *= r5;
    n *= r3;
    n += r0;
    n *= r6;
    n *= 2.99104023f;
    n *= -1.09625244f;
    n *= 2.09342670f;
    n *= 0.60021681f;
    n *= r1;
    return n;
} // Solution
