#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3;

    r0 = n += -3.14159274f;
    n *= -1.04351985f;
    n += r0;
    r0 = n *= 1.90050900f;
    r1 = n *= -1.52783406f;
    n = r0 *= n;
    n *= 0.03731050f;
    n = r0 += n;
    n += 2.57437515f;
    n *= 0.46803921f;
    r2 = n *= -3.73026514f;
    n = r0 *= n;
    n += r2;
    n += -3.52424335f;
    r2 = n *= 0.93517065f;
    n *= 0.38101199f;
    n *= -2.11919665f;
    n = r0 *= n;
    n *= -10.83785725f;
    n += 9.10328007f;
    n *= -0.24421614f;
    n *= 0.02200621f;
    r3 = n += -0.34868249f;
    n += 1.39839828f;
    n *= -0.75926542f;
    n += -0.97721589f;
    n *= 1.38640344f;
    n += r0;
    n *= 1.10204458f;
    n *= r3;
    n *= r2;
    n *= r1;
    return n;
} // Solution
