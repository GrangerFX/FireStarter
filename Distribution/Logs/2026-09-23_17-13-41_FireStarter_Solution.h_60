#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    r1 = n *= -0.08324213f;
    r2 = n *= -2.11970401f;
    n *= -0.17462075f;
    n *= r2;
    n += 0.01660939f;
    n *= -2.00904346f;
    r2 = n *= -5.27333879f;
    r3 = n *= -4.35847282f;
    n *= 0.00016523f;
    n *= -7.97074938f;
    n += -1.34224403f;
    r4 = n += 1.10617030f;
    r5 = n *= -0.18999869f;
    n *= r5;
    n *= r3;
    r3 = n += 0.35510704f;
    n *= r2;
    r2 = n += 2.71176505f;
    n = r2 *= n;
    n *= 0.03853983f;
    r5 = n *= 3.29052925f;
    n *= 0.82825720f;
    n *= r2;
    n *= r5;
    r5 = n += -3.84712505f;
    n += 2.19069171f;
    n *= r3;
    n *= r0;
    n *= r4;
    n += r1;
    n *= r5;
    return n;
} // Solution
