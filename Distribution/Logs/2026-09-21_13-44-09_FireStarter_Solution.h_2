#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6, r7;

    r0 = n += -3.14159274f;
    r1 = n *= -0.06989254f;
    r2 = n *= 1.22403073f;
    n *= r2;
    r2 = n += 0.46689436f;
    r3 = n += -0.59243983f;
    r4 = n *= 6.50620747f;
    r5 = n *= 0.48853275f;
    n *= -0.68965214f;
    n += -0.20968981f;
    r6 = n *= -8.67139721f;
    r7 = n += -0.55147779f;
    n *= -0.20715879f;
    n += r3;
    n += r7;
    r7 = n *= 0.07999972f;
    r3 = n *= 2.26743937f;
    n += 3.33762479f;
    n *= -1.29127312f;
    n += r5;
    n *= r7;
    n = r4 += n;
    n *= -8.37635517f;
    n = r4 *= n;
    n += r6;
    n *= r4;
    n *= 0.77556205f;
    n += 1.51221013f;
    n += r2;
    n *= r0;
    n *= r3;
    n += r1;
    return n;
} // Solution
