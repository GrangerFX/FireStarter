#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    n += -3.14159274f;
    n *= -0.10584621f;
    r0 = n *= -3.27728391f;
    r1 = n *= 1.40964198f;
    n = r0 *= n;
    n *= -0.41022551f;
    n *= -1.20796740f;
    n += -0.82959336f;
    n *= 1.13084054f;
    r2 = n *= 1.09314811f;
    n += r2;
    r2 = n *= 0.99743342f;
    n *= 0.06145602f;
    n *= 0.33326340f;
    n += -0.65682209f;
    r3 = n *= -0.22678241f;
    n += 1.03703856f;
    n += -0.16612057f;
    n = r0 += n;
    n += -1.36376321f;
    n *= 0.95849264f;
    r4 = n *= 0.15181747f;
    n *= 2.50365210f;
    n *= r3;
    n += -4.55238008f;
    n *= 1.91904616f;
    n *= r4;
    n = r0 += n;
    n *= 0.47136503f;
    n *= r0;
    n *= r2;
    n *= r1;
    return n;
} // Solution
