#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= 1.46468973f;
    r0 = n *= 0.06148600f;
    r1 = n *= -1.73271763f;
    n *= 0.75155032f;
    r2 = n *= 1.75193417f;
    n *= -4.63306904f;
    n *= r1;
    n += -0.24454394f;
    r1 = n += 1.75705826f;
    r3 = n *= 1.83878803f;
    n *= 2.48143291f;
    n *= 0.84911275f;
    r4 = n += -3.89402747f;
    r5 = n *= -0.05530866f;
    r6 = n += -3.29598665f;
    n += r3;
    n += -17.72499275f;
    n *= -3.69236445f;
    n += 11.55536079f;
    n *= -0.00515705f;
    n += -1.01868582f;
    n = r5 += n;
    n = r5 *= n;
    n *= -0.61193120f;
    n *= r6;
    n *= r1;
    n += r4;
    n *= r5;
    n *= r0;
    n *= -0.39741391f;
    n += r2;
    return n;
} // Solution
