#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= 0.35783163f;
    r0 = n *= -0.67036861f;
    r1 = n *= -0.86180544f;
    n *= -0.50474405f;
    r2 = n *= 3.50806260f;
    n *= -1.93459678f;
    n *= r1;
    n += -1.83983898f;
    r1 = n *= 2.02235508f;
    r3 = n += 3.10506415f;
    n *= 0.09526179f;
    n += 0.16255590f;
    r4 = n += 0.04010090f;
    r5 = n += -1.86535966f;
    r6 = n *= 0.21869461f;
    n += r3;
    n *= -0.01769238f;
    n *= 0.92667073f;
    n += -2.34293866f;
    n += 2.68583107f;
    n *= -1.27332020f;
    n = r5 *= n;
    n = r5 += n;
    n *= -0.26257113f;
    n *= r6;
    n *= r1;
    n += r4;
    n *= r5;
    n *= r0;
    n *= -3.85824680f;
    n += r2;
    return n;
} // Solution
