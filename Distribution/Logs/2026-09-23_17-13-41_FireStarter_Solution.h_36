#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    r0 = n += -3.14159274f;
    n *= 0.93890721f;
    r1 = n *= -0.02493885f;
    n *= r0;
    r0 = n += 0.23109941f;
    r2 = n += -1.38040411f;
    r3 = n += 2.76620531f;
    r4 = n *= 0.51429236f;
    n += 1.86847544f;
    r5 = n *= 0.64467484f;
    n *= 1.55588555f;
    r6 = n *= -4.52027321f;
    n = r0 *= n;
    n += r5;
    n *= 0.00602058f;
    n += -0.47578010f;
    n = r4 *= n;
    n *= r2;
    n += -1.93610489f;
    r2 = n *= -1.23500454f;
    n += 2.46276426f;
    r5 = n += 0.23039679f;
    n += r6;
    n += r5;
    n = r2 *= n;
    n += -2.83689570f;
    n *= r1;
    n *= r4;
    n *= r2;
    n *= 0.45781091f;
    n *= r3;
    n *= r0;
    return n;
} // Solution
