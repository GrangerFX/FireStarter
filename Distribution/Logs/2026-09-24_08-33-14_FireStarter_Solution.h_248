#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    r0 = n += -3.14159274f;
    r1 = n *= -1.78225994f;
    n *= r1;
    r1 = n += -0.71083504f;
    n *= -1.08458114f;
    n += r1;
    n += 3.15527487f;
    n += -1.17758656f;
    n *= -1.79083121f;
    n += -1.09927201f;
    n *= 0.00883163f;
    r1 = n *= -2.72243237f;
    r2 = n *= 1.49290717f;
    n = r1 += n;
    r3 = n *= -0.33834469f;
    n += r2;
    r2 = n += -0.06033346f;
    r4 = n *= -7.30723810f;
    n += r4;
    n *= -1.21131384f;
    n *= 0.05158224f;
    n += 2.01733589f;
    n *= r2;
    n *= 2.50716209f;
    n += 3.01316452f;
    n *= r1;
    r1 = n += 1.87576675f;
    n += 1.28692472f;
    n *= r1;
    n += -0.74063504f;
    n *= r0;
    n *= r3;
    return n;
} // Solution
