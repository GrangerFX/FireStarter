    n = r0 *= n;
    n *= r3;
    n *= r6;
    r6 = n *= 1.92505610f;
    n += 0.97138345f;
    r3 = n *= 0.69026893f;
    n += r6;
    n += r0;
    n *= 2.64081597f;
    n *= -1.97654533f;
    n *= r2;
    n *= r3;
    n *= r1;
    return n;
} // Solution
