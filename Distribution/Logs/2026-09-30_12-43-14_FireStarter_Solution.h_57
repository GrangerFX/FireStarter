#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159250f;
    r1 = n *= 0.05376935f;
    n = r1 *= n;
    r2 = n *= -3.98593259f;
    n *= 1.68321574f;
    n *= -0.89626753f;
    r3 = n *= -1.97955823f;
    r4 = n += 1.67489326f;
    r5 = n += 0.42002210f;
    n = r2 *= n;
    n += 0.19761133f;
    n *= -0.02907716f;
    n *= 17.48134041f;
    n += -2.45042777f;
    n *= -4.86434746f;
    n += -6.89313364f;
    n += -0.52109540f;
    n = r3 += n;
    n += r5;
    n = r2 *= n;
    n += 1.21341312f;
    n += r2;
    n *= 1.19410813f;
    n *= r3;
    n += r1;
    n += 4.01481247f;
    n += 0.32882056f;
    n += r4;
    r4 = n *= -0.26463267f;
    n += r4;
    n *= 0.14254601f;
    n *= r0;
    return n;
} // Solution
