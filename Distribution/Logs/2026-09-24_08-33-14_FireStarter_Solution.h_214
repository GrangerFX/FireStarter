#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3;

    r0 = n *= -2.49495912f;
    n *= -0.24754439f;
    n += r0;
    n += 3.04180312f;
    n += 2.85605311f;
    n *= 0.53238064f;
    n *= 1.23657680f;
    r0 = n *= 0.15837030f;
    r1 = n *= 1.42252195f;
    n *= r0;
    n *= 2.36992836f;
    r0 = n += -1.27472544f;
    n *= -1.37096441f;
    n *= -0.34563446f;
    r2 = n += -2.23452997f;
    n *= 0.76546526f;
    n *= -0.24517858f;
    r3 = n += 0.30841383f;
    n = r2 *= n;
    n = r0 *= n;
    n = r2 += n;
    n *= -1.00239182f;
    n += -0.56009257f;
    n += r2;
    n *= 0.90546286f;
    n *= -0.98775685f;
    n = r3 *= n;
    n *= r3;
    n *= 2.25198960f;
    n *= 2.93493676f;
    n *= r1;
    n *= r0;
    return n;
} // Solution
