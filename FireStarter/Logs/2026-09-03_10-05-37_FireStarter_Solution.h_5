#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    r1 = n *= -0.05955130f;
    n *= 0.78332555f;
    r2 = n *= -1.04217672f;
    r3 = n *= -2.14885354f;
    n = r2 *= n;
    r4 = n *= 2.39974976f;
    n *= 1.02294099f;
    r5 = n += 0.96380705f;
    n *= r0;
    n *= -0.98562717f;
    n *= 0.31731340f;
    n = r3 += n;
    n *= -0.15696804f;
    n *= r5;
    r5 = n *= -1.13183546f;
    r0 = n *= -1.58568096f;
    n *= r3;
    r3 = n += 0.31557411f;
    n *= r2;
    n += -5.10255623f;
    n += -1.02866828f;
    r2 = n *= 0.83181536f;
    n *= r4;
    n += -16.91769028f;
    n += 13.33374119f;
    n *= r0;
    n *= r1;
    n += -8.93963528f;
    n *= r2;
    n *= r3;
    n *= r5;
    return n;
} // Solution
