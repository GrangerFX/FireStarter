#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    r0 = n *= -0.18563898f;
    r1 = n *= -0.35018289f;
    n = r0 *= n;
    n *= -0.38815975f;
    n *= 2.10653520f;
    n += -0.77084947f;
    r2 = n *= -4.07122469f;
    r3 = n *= -0.41520351f;
    r4 = n += -0.20260513f;
    n *= r3;
    r3 = n *= 0.09377038f;
    n *= -0.43236694f;
    r5 = n += 1.42525113f;
    n = r4 += n;
    n *= -3.42780352f;
    n += -0.26061910f;
    r6 = n *= -0.01890141f;
    n = r3 += n;
    n += r3;
    n *= r5;
    n *= -2.75001550f;
    n = r2 *= n;
    n *= r4;
    n *= 0.87787896f;
    n *= 0.60813046f;
    n *= r2;
    n += r6;
    n += r0;
    n *= 3.42590880f;
    n *= 3.04677320f;
    n *= r1;
    return n;
} // Solution
