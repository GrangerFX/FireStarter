#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    r0 = n += -3.14159274f;
    n *= 1.81531668f;
    r1 = n *= 2.63302851f;
    n *= -0.01248716f;
    n *= r1;
    r1 = n += 2.28936458f;
    r2 = n *= -2.14047551f;
    n += r1;
    n *= 0.47411910f;
    n *= 0.53510797f;
    r1 = n *= -0.27173471f;
    n *= 75.44567108f;
    n += -4.30411959f;
    n *= 0.00730382f;
    r3 = n += 0.79929084f;
    r4 = n *= 1.47515106f;
    n = r4 *= n;
    n += 3.32138634f;
    n *= r3;
    n += 2.54347324f;
    n += 2.86148024f;
    n += r4;
    n *= r1;
    r1 = n += -1.05217600f;
    n *= 0.24566405f;
    n *= -0.89921981f;
    n = r1 *= n;
    n *= -3.03869581f;
    n += r2;
    n *= 0.18473157f;
    n += r1;
    n *= r0;
    return n;
} // Solution
