#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    n += -3.14159274f;
    r0 = n *= 0.20584218f;
    n *= 2.54973769f;
    n *= 1.57327867f;
    n *= 5.25074768f;
    n *= -0.17423256f;
    r1 = n *= -2.05170703f;
    n *= r0;
    n += -0.51429170f;
    r0 = n *= 0.13038735f;
    n *= 1.80343843f;
    r2 = n *= -0.01745057f;
    r3 = n += -0.14201888f;
    n += r3;
    n *= -1.80180311f;
    n += -1.38297129f;
    n *= -2.01504612f;
    r3 = n += -0.19617093f;
    n *= 1.96345866f;
    n *= -2.86588430f;
    n = r2 *= n;
    r4 = n += -1.06702030f;
    n += r0;
    n += 0.74044120f;
    r0 = n *= -0.93024814f;
    n = r4 *= n;
    n *= r4;
    n += r0;
    n += r2;
    n *= -0.76117504f;
    n *= r3;
    n *= r1;
    return n;
} // Solution
