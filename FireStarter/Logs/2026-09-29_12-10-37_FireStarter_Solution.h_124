#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= 0.58714974f;
    r0 = n *= -0.09701940f;
    r1 = n *= -1.56601632f;
    n *= 1.70138121f;
    r2 = n *= -0.76355040f;
    n *= -3.96239710f;
    n *= r1;
    n += -1.90159035f;
    r1 = n *= 0.92178631f;
    r3 = n += 1.45472121f;
    n *= 5.31251574f;
    n *= -0.25354829f;
    r4 = n *= -1.94678962f;
    r5 = n *= -0.28545383f;
    r6 = n *= 1.47560000f;
    n += r3;
    n *= -0.81006533f;
    n *= -2.07470965f;
    n += -0.84846950f;
    n *= -1.38150537f;
    n *= 1.09507573f;
    n = r5 += n;
    n = r5 *= n;
    n *= -1.68031943f;
    n += r6;
    n *= r1;
    n *= r4;
    n *= r5;
    n *= r0;
    n *= -1.79571331f;
    n += r2;
    return n;
} // Solution
