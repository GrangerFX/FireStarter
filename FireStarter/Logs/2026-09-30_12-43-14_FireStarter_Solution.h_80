    n *= 2.59281135f;
    r3 = n *= -0.39111996f;
    r4 = n *= -4.29659986f;
    n += -0.61503851f;
    n = r1 *= n;
    n = r3 += n;
    n += r1;
    r1 = n += 1.15338600f;
    n *= -2.32367516f;
    n *= -2.15367436f;
