#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= -0.15541695f;
    r0 = n *= 0.37023884f;
    r1 = n *= -2.12402987f;
    n *= 0.96337783f;
    r2 = n *= -2.16083741f;
    n *= 0.77629513f;
    n *= r1;
    n += -0.07694431f;
    r1 = n += 2.33037734f;
    r3 = n += -2.41962790f;
    n *= -3.76643944f;
    n *= -4.01104403f;
    r4 = n += 3.42832637f;
    r5 = n *= -0.86468709f;
    r6 = n += -2.21296883f;
    n += r3;
    n *= -0.46119606f;
    n *= -0.57035947f;
    n *= -4.27352047f;
    n += -2.10820079f;
    n *= 0.99752313f;
    n = r5 += n;
    n = r5 *= n;
    n *= -1.60176098f;
    n *= r6;
    n *= r1;
    n += r4;
    n *= r5;
    n *= r0;
    n *= 5.23511934f;
    n += r2;
    return n;
} // Solution
