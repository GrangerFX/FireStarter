#define SOLUTION_VARIATIONS 1
#define SOLUTION_VARIATION 0

#ifndef __CUDACC__
#include <cmath>
#endif

#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    r0 = n += -3.14159274f;
    n *= -0.24671718f;
    r1 = n *= 1.64480698f;
    n = r1 *= n;
    n *= 5.13927746f;
    n += -3.59808040f;
    n += 0.77383655f;
    n *= -0.04209093f;
    r2 = n += 2.23521757f;
    n *= 0.48842248f;
    r3 = n += -0.71248353f;
    n *= 0.66968745f;
    n = r2 *= n;
    n *= -1.63142014f;
    r4 = n += -0.37505391f;
    n += r3;
    r3 = n += -1.27118552f;
    n *= r4;
    n = r1 *= n;
    n *= 1.03434920f;
    r4 = n *= -0.03452931f;
    n += r2;
    n *= -1.25785995f;
    n = r4 += n;
    n = r3 += n;
    n *= r3;
    n += r4;
    n *= -0.58039558f;
    n = r1 += n;
    n += r1;
    n *= r0;
    n *= 0.09185901f;
    return n;
} // Solution
