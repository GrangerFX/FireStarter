#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= -0.04130908f;
    r0 = n *= -1.45210505f;
    r1 = n *= 3.28406739f;
    n *= 0.62088883f;
    r2 = n *= -3.71077442f;
    n *= 2.12222099f;
    n *= r1;
    n += 1.32675636f;
    r1 = n *= -0.73062366f;
    r3 = n *= 0.03885862f;
    n *= 2.90698981f;
    n += -1.43181324f;
    r4 = n *= -1.07546413f;
    r5 = n += -0.05588323f;
    r6 = n += -0.40218568f;
    n += r3;
    n *= 1.51075447f;
    n *= 1.25040615f;
    n *= -1.97140133f;
    n *= -1.29869950f;
    n *= -0.26161474f;
    n = r5 *= n;
    n = r5 *= n;
    n += 1.60688615f;
    n *= r6;
    n *= r1;
    n *= r4;
    n += r5;
    n *= r0;
    n *= 1.10487258f;
    n += r2;
    return n;
} // Solution
