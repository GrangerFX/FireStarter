#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    r0 = n += -3.14159274f;
    r1 = n *= -0.14853388f;
    n = r1 *= n;
    n += 0.27793241f;
    r2 = n *= -1.97993445f;
    r3 = n += 0.71584398f;
    n *= -5.84874201f;
    n *= -0.72780716f;
    n *= -6.15910196f;
    r4 = n *= 0.05401408f;
    n *= -1.88739932f;
    n = r4 += n;
    n *= -2.19719028f;
    r5 = n *= 0.83855975f;
    n += r2;
    n = r3 += n;
    r2 = n += -0.05548472f;
    n *= -2.93263388f;
    r6 = n += 1.48893285f;
    n *= r5;
    r5 = n *= 0.03676018f;
    n += -1.85571301f;
    n *= r6;
    n += r1;
    n += r4;
    n *= -2.30927634f;
    n *= r2;
    n *= 0.83638334f;
    n *= r5;
    n += 0.66743350f;
    n *= r0;
    n *= r3;
    return n;
} // Solution
