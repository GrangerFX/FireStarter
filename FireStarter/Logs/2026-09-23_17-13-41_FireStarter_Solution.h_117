#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    r0 = n += -3.14159274f;
    n *= 0.06944841f;
    r1 = n *= 0.47820362f;
    r2 = n *= -1.92906404f;
    n *= r2;
    n *= -0.66219693f;
    r2 = n += 1.14892697f;
    r3 = n += -0.22525184f;
    n *= 3.29411149f;
    n = r1 *= n;
    n *= 1.58923173f;
    n *= 4.47021770f;
    n *= r1;
    n *= 2.87827301f;
    r1 = n += -0.54777253f;
    n *= -1.70314550f;
    r4 = n *= -2.49551821f;
    n += 0.09129704f;
    n += r4;
    n *= -0.01496866f;
    n *= -1.51664007f;
    n += -1.20800865f;
    n = r2 *= n;
    r4 = n += -0.82977253f;
    n *= r3;
    n *= r1;
    n *= -0.91150391f;
    n += r4;
    n *= r2;
    n *= -0.18439960f;
    n += -0.05117111f;
    n *= r0;
    return n;
} // Solution
