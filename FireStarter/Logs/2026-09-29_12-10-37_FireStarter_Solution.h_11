#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= 0.14192908f;
    r0 = n *= 2.33161426f;
    r1 = n *= 0.24449167f;
    n *= 0.30911353f;
    r2 = n *= -2.92845631f;
    n *= -2.70143437f;
    n *= r1;
    n *= 1.41307926f;
    r1 = n += -1.71257329f;
    r3 = n += 1.51895583f;
    n *= -0.12732260f;
    n *= -7.23158836f;
    r4 = n *= 1.77459836f;
    r5 = n *= -0.57050824f;
    r6 = n += 0.58119249f;
    n += r3;
    n += -0.52484471f;
    n *= -1.64902806f;
    n *= -3.29532433f;
    n += -1.54512727f;
    n *= -1.06919432f;
    n = r5 += n;
    n = r5 *= n;
    n *= -0.26284945f;
    n *= r6;
    n += r1;
    n *= r4;
    n *= r5;
    n *= r0;
    n *= -1.59925747f;
    n += r2;
    return n;
} // Solution
