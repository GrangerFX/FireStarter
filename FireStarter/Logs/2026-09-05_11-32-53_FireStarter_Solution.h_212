#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= 1.11568499f;
    r0 = n *= -2.97652841f;
    r1 = n *= 0.15132301f;
    n *= 0.30886930f;
    r2 = n *= -1.41430557f;
    n *= 1.20713460f;
    n *= r1;
    n += 0.97075516f;
    r1 = n *= 0.58537513f;
    r3 = n += 1.02912271f;
    n *= -0.07171854f;
    n *= 3.11890197f;
    r4 = n *= -0.10517064f;
    r5 = n *= -0.62138003f;
    r6 = n *= -1.45934570f;
    n += r3;
    n += 2.39578223f;
    n += 1.13366508f;
    n *= 1.82923520f;
    n *= 1.96318316f;
    n += -1.39319587f;
    n = r5 *= n;
    n = r5 *= n;
    n *= 1.36789072f;
    n += r6;
    n *= r1;
    n *= r4;
    n += r5;
    n *= r0;
    n *= 2.21769571f;
    n += r2;
    return n;
} // Solution
