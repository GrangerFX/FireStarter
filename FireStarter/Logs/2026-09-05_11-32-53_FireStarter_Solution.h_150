#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= -0.25453740f;
    r0 = n *= 1.84712648f;
    r1 = n *= 2.11844277f;
    n *= -0.06473286f;
    r2 = n *= -1.55173910f;
    n *= 1.21206987f;
    n *= r1;
    n += 1.25210357f;
    r1 = n += -2.23467660f;
    r3 = n += 0.60155344f;
    n += -5.45994663f;
    n *= 0.07899911f;
    r4 = n *= -1.26707757f;
    r5 = n *= -0.56021219f;
    r6 = n += -4.71054220f;
    n *= r3;
    n *= -2.15982389f;
    n += -0.75982040f;
    n *= -0.01830368f;
    n += 1.28147388f;
    n += 0.21628678f;
    n = r5 += n;
    n = r5 *= n;
    n *= -2.95254159f;
    n += r6;
    n *= r1;
    n *= r4;
    n *= r5;
    n *= r0;
    n *= 0.21578641f;
    n += r2;
    return n;
} // Solution
