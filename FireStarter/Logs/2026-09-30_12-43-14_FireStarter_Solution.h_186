#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    r0 = n += -3.14159274f;
    n *= 0.03279406f;
    r1 = n *= 2.46016383f;
    r2 = n *= 2.63498449f;
    n *= -0.33431214f;
    r3 = n *= 1.67896640f;
    r4 = n *= 1.49236488f;
    n *= -0.26324338f;
    n = r1 *= n;
    n *= r4;
    n = r2 += n;
    n *= r3;
    r3 = n += 1.25261974f;
    n += -0.37821358f;
    r4 = n *= -0.88165504f;
    n += 0.80695993f;
    n += -0.24986643f;
    n = r2 *= n;
    n *= 0.46365070f;
    n *= r0;
    n *= -0.00090658f;
    n *= -0.22099733f;
    n *= -1.32150853f;
    r0 = n += 2.08414674f;
    n += r3;
    r3 = n *= -2.69247103f;
    n *= r1;
    n += 1.52396238f;
    n *= r0;
    n *= r4;
    n *= r2;
    n *= r3;
    return n;
} // Solution
