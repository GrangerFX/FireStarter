    n *= -11.13284969f;
    n *= 0.69863784f;
    n *= 0.15919821f;
    n *= -1.07272065f;
    n *= 0.00523797f;
    n = r5 *= n;
    n = r5 *= n;
    n *= 6.88361835f;
    n += r6;
    n *= r1;
    n += r4;
    n *= r5;
    n *= r0;
    n *= -14.92578983f;
    n += r2;
    return n;
} // Solution
