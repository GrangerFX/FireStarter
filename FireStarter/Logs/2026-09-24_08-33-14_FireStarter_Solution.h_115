#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    n += -3.14159250f;
    r0 = n *= -0.18418685f;
    r1 = n *= -1.78827631f;
    n *= 0.47368729f;
    n *= r1;
    r1 = n += -2.58681488f;
    n += 1.49504697f;
    r2 = n += -1.11239672f;
    n += r2;
    n += 4.04087496f;
    r2 = n *= 0.92145318f;
    r3 = n *= 0.04067555f;
    n *= 1.82121027f;
    n *= 1.59126878f;
    r4 = n *= -0.81964618f;
    r5 = n += -0.53853029f;
    n = r2 += n;
    n += 1.23108208f;
    n *= -0.96744722f;
    n *= r3;
    n += r1;
    n = r5 += n;
    n *= 2.47772670f;
    n *= -0.96319312f;
    n += -1.83655858f;
    n *= r4;
    n += 0.86027867f;
    n *= r0;
    n *= r5;
    n = r2 *= n;
    n += r2;
    n += 0.00000010f;
    return n;
} // Solution
