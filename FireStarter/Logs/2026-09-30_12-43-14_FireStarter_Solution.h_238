#define SOLUTION_VARIATIONS 1
#define SOLUTION_VARIATION 0

#ifndef __CUDACC__
#include <cmath>
#endif

#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    n *= -0.34299514f;
    r1 = n *= 0.64496613f;
    n *= 0.18906990f;
    r2 = n *= 1.84285820f;
    r3 = n *= 116.37325287f;
    n += r3;
    n *= 0.06850169f;
    n += r0;
    r0 = n *= -1.82077610f;
    n *= r2;
    r2 = n += 0.11135641f;
    r3 = n += 0.90442383f;
    r4 = n += 2.89546156f;
    r5 = n *= 0.28569457f;
    n *= 1.05903375f;
    n *= r3;
    n += r4;
    r4 = n += 1.70277238f;
    n = r2 *= n;
    n *= 0.10805693f;
    r3 = n += 0.61936069f;
    n *= r5;
    n += r2;
    n += 0.02373644f;
    n *= 0.24574032f;
    n *= r4;
    n *= 0.26338878f;
    n *= r0;
    n *= r3;
    n *= -3.85468388f;
    n += r1;
    return n;
} // Solution
