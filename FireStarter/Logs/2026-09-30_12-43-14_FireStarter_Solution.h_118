    r2 = n += 1.03172863f;
    r3 = n += -1.73169982f;
    n *= r0;
    r0 = n += -1.42693281f;
    n += -0.21866666f;
    n *= -4.48199749f;
    n *= r1;
    n = r2 *= n;
    r1 = n += 1.02810967f;
    n *= -2.78600216f;
    n *= 0.43924305f;
    n *= r2;
    n = r3 *= n;
    n = r1 += n;
    n = r3 += n;
