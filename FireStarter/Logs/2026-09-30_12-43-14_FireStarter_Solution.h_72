#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    r0 = n *= -1.95710874f;
    r1 = n *= 0.08505085f;
    r2 = n *= -2.08470511f;
    n += r2;
    n *= r1;
    r1 = n *= -0.82305491f;
    r2 = n *= 0.00374728f;
    n *= 10.70465660f;
    n *= -1.67108572f;
    r3 = n += 2.66763139f;
    n *= -2.13401222f;
    n *= 0.00111128f;
    r4 = n += -1.52045047f;
    n *= r2;
    n = r3 *= n;
    n += -0.27963883f;
    r2 = n += 0.66272241f;
    r5 = n *= -1.36785007f;
    r6 = n *= -2.12804627f;
    n *= r1;
    n *= r5;
    n += 0.13622715f;
    n = r2 += n;
    n += 0.50363046f;
    n = r6 += n;
    n *= r4;
    n *= r2;
    n *= r6;
    n += r3;
    n *= -0.14097747f;
    n *= r0;
    return n;
} // Solution
