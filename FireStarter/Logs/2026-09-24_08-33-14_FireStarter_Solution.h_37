#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159250f;
    r1 = n *= -0.89297235f;
    n *= 0.84354365f;
    n *= -0.86659652f;
    n *= r1;
    r1 = n += 1.90838742f;
    n += -0.07718370f;
    n *= -0.02362768f;
    r2 = n += -0.72309691f;
    r3 = n *= 1.97648060f;
    n *= -0.35760656f;
    r4 = n *= -0.60735148f;
    r5 = n += 1.42340696f;
    n *= 3.33515668f;
    n = r1 += n;
    n *= -1.90632248f;
    n *= -0.15284902f;
    n *= -0.00000006f;
    n += r0;
    n *= -0.31457162f;
    n = r4 *= n;
    n = r5 *= n;
    n *= r5;
    n += -2.01449847f;
    n *= 4.11150217f;
    n *= 1.10181212f;
    n *= r3;
    n += -2.37956762f;
    n *= r2;
    n *= 0.19822587f;
    n *= r4;
    n *= r1;
    return n;
} // Solution
