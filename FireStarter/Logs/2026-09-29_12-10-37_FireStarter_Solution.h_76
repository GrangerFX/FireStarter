#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= -0.17491513f;
    r0 = n *= -0.73688495f;
    r1 = n *= -1.82480943f;
    n *= -0.58594024f;
    r2 = n *= -0.49008515f;
    n *= -3.30502915f;
    n *= r1;
    n += 0.85586160f;
    r1 = n += -0.70272523f;
    r3 = n *= 0.02567641f;
    n *= 2.36294723f;
    n *= -1.30610967f;
    r4 = n *= -2.53740001f;
    r5 = n += 0.55117571f;
    r6 = n *= -2.36654639f;
    n *= r3;
    n *= 1.15436471f;
    n += -0.55083019f;
    n *= -5.36235857f;
    n *= 1.21498764f;
    n *= -0.83847249f;
    n = r5 *= n;
    n = r5 *= n;
    n *= -2.77719355f;
    n *= r6;
    n *= r1;
    n += r4;
    n += r5;
    n *= r0;
    n *= -1.44552362f;
    n += r2;
    return n;
} // Solution
