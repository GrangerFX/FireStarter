#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159250f;
    n *= 0.27937877f;
    r0 = n *= -1.74376583f;
    r1 = n *= -1.20953608f;
    n *= 0.19209148f;
    r2 = n *= -2.22033000f;
    n *= 1.35770535f;
    n *= r1;
    n *= 2.08303881f;
    r1 = n += 2.55814099f;
    r3 = n *= -0.10263913f;
    n *= 0.08582868f;
    n += -0.36939555f;
    r4 = n *= -1.73065162f;
    r5 = n *= -0.97224396f;
    r6 = n *= -1.70805311f;
    n *= r3;
    n *= -0.00302579f;
    n *= -0.46069098f;
    n *= -4.01442337f;
    n *= -2.53753901f;
    n += -1.20153105f;
    n = r5 *= n;
    n = r5 *= n;
    n *= -2.67707705f;
    n *= r6;
    n *= r1;
    n *= r4;
    n *= r5;
    n *= r0;
    n *= -0.73474157f;
    n += r2;
    return n;
} // Solution
