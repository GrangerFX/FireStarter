#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5;

    r0 = n += -3.14159274f;
    n *= -0.11990413f;
    n *= 1.39288914f;
    r1 = n *= 0.59291816f;
    n = r1 *= n;
    r2 = n *= -1.76366937f;
    n += 1.65206444f;
    r3 = n += -1.52208734f;
    n *= -3.41110206f;
    n += -0.13887557f;
    n *= 2.61549234f;
    r4 = n *= -0.05149461f;
    n += r1;
    r1 = n *= -2.10583758f;
    n += -1.33748150f;
    n += 1.90170431f;
    r5 = n *= 2.69747734f;
    n = r2 *= n;
    n += r5;
    n *= -1.78158474f;
    n = r3 += n;
    n += -1.28297508f;
    n *= -0.49715441f;
    r5 = n *= 1.23371720f;
    n *= r5;
    n += r2;
    n *= 3.27617717f;
    n += r1;
    n += -4.32560968f;
    n *= r3;
    n *= r0;
    n *= r4;
    return n;
} // Solution
