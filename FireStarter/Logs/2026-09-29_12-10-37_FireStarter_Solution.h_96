#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= 1.37298453f;
    r0 = n *= 0.09064689f;
    r1 = n *= 2.69709325f;
    n *= -0.62114930f;
    r2 = n *= 0.86330968f;
    n *= 1.52092588f;
    n *= r1;
    n *= -0.89795196f;
    r1 = n += -0.57743847f;
    r3 = n *= 0.86755717f;
    n *= -8.62951660f;
    n *= -0.31708321f;
    r4 = n *= 0.01344281f;
    r5 = n += -0.65213513f;
    r6 = n *= 1.34851956f;
    n *= r3;
    n *= -2.81872630f;
    n *= 0.22455524f;
    n *= -4.55051422f;
    n *= 0.20405442f;
    n *= -0.17567815f;
    n = r5 += n;
    n = r5 *= n;
    n *= 0.67507130f;
    n *= r6;
    n *= r1;
    n += r4;
    n *= r5;
    n *= r0;
    n *= -78.57406616f;
    n += r2;
    return n;
} // Solution
