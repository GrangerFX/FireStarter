#ifndef __CUDACC__
#include <cmath>
#endif

#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    n *= 0.48416173f;
    r0 = n += -1.52103901f;
    r1 = n *= -0.52325153f;
    n *= 2.20852351f;
    r2 = n += 1.52492321f;
    n += -0.60917825f;
    n *= 0.95825589f;
    r3 = n += -0.87751800f;
    n += -1.46126640f;
    n *= 0.73771268f;
    n = r2 *= n;
    n *= 1.46741498f;
    n += 1.69270790f;
    n *= 1.32702219f;
    r4 = n += -1.45737946f;
    n *= -0.01496615f;
    n *= r4;
    n += r2;
    r2 = n *= 0.08686067f;
    n += -1.16266727f;
    n *= 0.99758363f;
    r4 = n += -1.41924536f;
    n *= -2.65224338f;
    n = r3 *= n;
    n *= r0;
    n += 1.27676773f;
    n = r1 *= n;
    n *= r2;
    n *= r4;
    n += r1;
    n += r3;
    n *= 0.23057829f;
    return n;
} // Solution
