#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    r0 = n += -3.14159274f;
    r1 = n *= 0.35906962f;
    n = r1 *= n;
    r2 = n *= 0.03311417f;
    r3 = n *= -1.17526042f;
    n += 0.34248224f;
    r4 = n += 0.05798782f;
    n *= -2.38718653f;
    r5 = n *= -1.17368913f;
    n = r4 += n;
    r6 = n *= -0.95453799f;
    n += 1.64575911f;
    n += r1;
    n += -1.57762647f;
    n *= 0.00834543f;
    r1 = n += -0.51947182f;
    n = r2 += n;
    n = r3 *= n;
    n += r4;
    n *= r5;
    n *= 2.14139843f;
    n += 2.77159858f;
    n += r2;
    n = r1 *= n;
    n = r3 *= n;
    n += r3;
    n *= r6;
    n += -0.16084455f;
    n *= r1;
    n *= -0.43264100f;
    n *= 4.58758116f;
    n *= r0;
    return n;
} // Solution
