    n *= 2.13720059f;
    n *= 0.09004218f;
    n *= 3.13716531f;
    n += -1.22076952f;
    r1 = n *= 0.16089030f;
    r2 = n *= 5.65036964f;
    n *= 3.04159808f;
    n *= -0.01981199f;
    n *= -0.35439900f;
    r3 = n += -0.93935376f;
    r4 = n += 1.33747351f;
    n += r4;
    n = r3 *= n;
    r4 = n *= 1.05648577f;
    n += r1;
    n = r3 += n;
    n *= 1.24508262f;
    n = r2 += n;
    n *= r4;
    n = r2 += n;
    r4 = n *= -0.68303847f;
    n += r3;
    n += r2;
    n *= r0;
    n *= r4;
    return n;
} // Solution
