#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4;

    r0 = n += -3.14159274f;
    r1 = n *= 0.19118121f;
    n *= r0;
    n *= 0.74264455f;
    r0 = n += -1.25458646f;
    r2 = n += 0.46176782f;
    n *= 0.63949907f;
    n = r2 *= n;
    n *= -2.25248718f;
    n *= -0.02050840f;
    n *= -3.13512135f;
    r3 = n += -0.61704636f;
    n += r0;
    r0 = n += -0.30195528f;
    n *= r0;
    n = r3 += n;
    n += 0.16723926f;
    n *= -0.05993256f;
    n *= -0.05396039f;
    r0 = n *= 2.60882545f;
    n *= -0.20394787f;
    r4 = n *= -1.20289481f;
    n *= 2.50866222f;
    n = r4 += n;
    n *= -3.62173557f;
    n *= r0;
    n += r2;
    n *= 2.58903360f;
    n *= r4;
    n += r3;
    n *= -1.20546639f;
    n *= r1;
    return n;
} // Solution
