#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6, r7, r8;

    r0 = n += -3.14159274f;
    n *= -1.71245515f;
    r1 = n *= -1.99575901f;
    r2 = n *= -0.31383795f;
    n += r0;
    r0 = n *= -0.44199255f;
    n *= 1.95577896f;
    n *= r1;
    r1 = n *= -2.71144176f;
    n *= 0.03533912f;
    r3 = n += 1.73894119f;
    r4 = n *= 0.31501564f;
    r5 = n += -0.52271354f;
    r6 = n *= -0.00812547f;
    r7 = n *= -3.96986556f;
    n *= r7;
    r7 = n += -3.48090100f;
    r8 = n *= 1.98692143f;
    n *= r8;
    n += r7;
    n = r1 += n;
    n *= -1.70790303f;
    n *= r6;
    n += 0.20995580f;
    n *= r2;
    r2 = n *= 2.07998848f;
    n *= r3;
    n *= r4;
    n += r0;
    n *= r1;
    n *= r5;
    n += r2;
    return n;
} // Solution
