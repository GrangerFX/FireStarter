#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= 0.10819288f;
    r0 = n *= -2.59392357f;
    r1 = n *= 1.70411861f;
    n *= -1.21820557f;
    r2 = n *= -0.39196774f;
    n *= 0.15727375f;
    n *= r1;
    n += -0.10964825f;
    r1 = n *= 4.46441603f;
    r3 = n *= -0.38274083f;
    n += 1.75520778f;
    n *= 0.75257981f;
    r4 = n *= 2.97706223f;
    r5 = n *= -1.89050746f;
    r6 = n *= 1.06619990f;
    n *= r3;
    n *= 2.25705218f;
    n *= 0.02257936f;
    n *= 2.37741756f;
    n += -2.11311841f;
    n *= -0.00164072f;
    n = r5 *= n;
    n = r5 += n;
    n *= -7.08229446f;
    n += r6;
    n *= r1;
    n *= r4;
    n *= r5;
    n *= r0;
    n *= -2.48143721f;
    n += r2;
    return n;
} // Solution
