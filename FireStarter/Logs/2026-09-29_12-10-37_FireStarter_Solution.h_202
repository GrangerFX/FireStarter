#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    n += -3.14159274f;
    n *= 2.72077656f;
    r0 = n *= 1.06813884f;
    r1 = n *= -0.14183044f;
    n *= 1.00878286f;
    r2 = n *= 0.64684027f;
    n *= 2.43151951f;
    n *= r1;
    n += -0.76462060f;
    r1 = n *= -1.29240084f;
    r3 = n *= -0.10389690f;
    n += -0.23246890f;
    n *= 0.04327659f;
    r4 = n += -0.30578715f;
    r5 = n *= 1.58690822f;
    r6 = n *= -1.75635850f;
    n *= r3;
    n *= -1.48410952f;
    n *= -0.66152728f;
    n += -1.56892204f;
    n *= 0.14429905f;
    n *= -2.65991330f;
    n = r5 *= n;
    n = r5 *= n;
    n *= -3.47207928f;
    n *= r6;
    n *= r1;
    n *= r4;
    n += r5;
    n *= r0;
    n *= -1.21235418f;
    n += r2;
    return n;
} // Solution
