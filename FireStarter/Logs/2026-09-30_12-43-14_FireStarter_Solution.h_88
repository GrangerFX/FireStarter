#define SOLUTION_PI 3.14159265f
#define SOLUTION_MIN 0.0f
#define SOLUTION_MAX (2.0f * SOLUTION_PI)

inline float SolutionTarget(float n, unsigned int variation = 0)
{
    switch (variation & 3) {
        default:
        case 0:
            return sinf(n);
        case 1:
            return sinf((n + 0.4f) * 0.9f) - n * 0.2f + 0.5f;
        case 2:
            return sinf(n * 1.2f) + n * 0.2f;
        case 3:
            return fabsf(fmodf(fabsf(n - SOLUTION_PI * 0.5f), SOLUTION_PI * 2.0f) - SOLUTION_PI) - SOLUTION_PI * 0.5f;
    }
} // SolutionTarget

inline float Solution(float n)
{
    float r0, r1, r2, r3, r4, r5, r6;

    r0 = n += -3.14159274f;
    r1 = n *= -0.78546673f;
    n *= -1.58863246f;
    n *= -0.97954756f;
    n *= -0.12226974f;
    r2 = n *= 1.47268164f;
    n = r2 *= n;
    n *= 3.15826249f;
    n *= -2.32567739f;
    r3 = n += 1.68530679f;
    n *= 1.82419705f;
    r4 = n *= -0.73984039f;
    n *= -0.00046423f;
    r5 = n += 0.06124294f;
    r6 = n *= 1.65029216f;
    n = r3 *= n;
    n *= r3;
    r3 = n += 4.93383169f;
    n += 0.12698920f;
    n *= -0.48390037f;
    n += r4;
    r4 = n *= -0.24365656f;
    n += r3;
    n *= -1.55751216f;
    n *= -1.73894274f;
    n *= r0;
    n *= r5;
    n *= r2;
    n += r1;
    n = r4 *= n;
    n *= r6;
    n += r4;
    return n;
} // Solution
